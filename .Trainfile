# .Trainfile — Declarative Training Recipe for Trainaya (uv + PyTorch Engine)
# Run with: trainaya train

# Base model: Ollaya/Ollama tag, GGUF path, or HuggingFace Causal LLM repo
FROM winnow:e4b

# Task type: 'decision' (choice / noul / score), 'classification', or 'nli'
TASK decision

# Curated dataset produced by `trainaya curate` (or custom JSONL/CSV)
DATA ./data/curated_train.jsonl

# Hyperparameters
PARAMETER epochs 8
PARAMETER batch_size 8
PARAMETER lr 1.5e-4
PARAMETER max_length 512
PARAMETER warmup_ratio 0.10
PARAMETER lr_scheduler cosine
PARAMETER lora_r 16
PARAMETER lora_alpha 32
PARAMETER device auto

# Output directory & automatic registration tag
OUTPUT ./output/{tag}
REGISTER custom-decider:v{ patch + 1 }
