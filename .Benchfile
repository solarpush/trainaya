# .Benchfile — Declarative 13-Subset Nimble Benchmark Configuration
# Run with: trainaya bench (or `trainaya bench --model push_ministral:8b`)

MODEL push_ministral:8b
BASELINE winnow:e4b

# Ollaya runtime endpoint
URL http://127.0.0.1:11435

# Evaluate all 13 public benchmark subsets (or specify a comma-separated subset list)
LIMIT 50

# Save JSON scorecard report
OUTPUT ./results/bench_{model}.json
